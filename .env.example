# 실행 환경은 프로세스 환경변수로 지정한다. 예: ENV=prod uv run fastapi run app/main.py

DB_HOST=<postgres-hostname>
DB_PORT=<postgres-port>
DB_NAME=<database-name>
DB_USER=<database-user>
DB_PASSWORD=<database-password>

BACKOFFICE_PASSWORD=<backoffice-password>

SUPABASE_URL=<supabase-project-url>
SUPABASE_PUBLISHABLE_KEY=<sb_publishable key>
SUPABASE_SECRET_KEY=<server-only sb_secret key>

OAUTH_CREDENTIALS_KEY=<fernet-key>
GOOGLE_CLIENT_ID=<supabase-google-web-client-id>
GOOGLE_CLIENT_SECRET=<supabase-google-client-secret>
APPLE_CLIENT_IDS=["<native-apple-client-id>"]
APPLE_TEAM_ID=<apple-team-id>
APPLE_KEY_ID=<apple-sign-in-key-id>
APPLE_PRIVATE_KEY='<apple-sign-in-private-key-pem-with-real-newlines>'
KAKAO_ADMIN_KEY=<kakao-app-admin-key>

S3_REGION=<aws-region>
S3_BUCKET_NAME=<bucket-name>

REDIS_HOST=<redis-hostname>
REDIS_PORT=<redis-port>
REDIS_DB=<redis-db-index>
REDIS_USERNAME=<redis-username>
REDIS_PASSWORD=<redis-password>

LOG_LEVEL=<DEBUG-or-INFO-or-WARNING-or-ERROR-or-CRITICAL>
